---
layout: layouts/base.njk
---
{% set titre = p.titre if p else titre %}
{% set reference = p.reference if p else reference %}
{% set prix = p.prix if p else prix %}
{% set categorie = p.categorie if p else categorie %}
{% set dimensions = p.dimensions if p else dimensions %}
{% set etat = p.etat if p else etat %}
{% set vendu = p.vendu if p else vendu %}
{% set photos = p.photos if p else photos %}
{% set histoire = p.histoireHtml if p else content %}
{% set artiste = p.artiste if p else artiste %}

<article class="conteneur fiche-produit">
  <nav class="fil-ariane"><a href="/boutique/">← Retour à la boutique</a></nav>

  <div class="fiche-produit__grille">
    <div class="fiche-produit__galerie">
      {% if vendu %}<span class="bandeau-vendu bandeau-vendu--grand">Vendu</span>{% endif %}
      {% for photo in photos %}
        <img src="{{ photo }}" alt="{{ titre }} — photo {{ loop.index }}" loading="lazy">
      {% endfor %}
    </div>

    <div class="fiche-produit__infos">
      {% if categorie %}<span class="etiquette-categorie">{{ categorie | nomCategorie }}</span>{% endif %}
      <h1>{{ titre }}</h1>
      {% if artiste %}<p class="fiche-produit__artiste">{{ artiste }}</p>{% endif %}
      <p class="fiche-produit__prix">{{ prix | prixFormate }}</p>

      <div class="fiche-produit__caracteristiques">
        {% if reference %}<div><dt>Référence</dt><dd>{{ reference }}</dd></div>{% endif %}
        {% if dimensions %}<div><dt>Dimensions</dt><dd>{{ dimensions }}</dd></div>{% endif %}
        {% if etat %}<div><dt>État</dt><dd>{{ etat }}</dd></div>{% endif %}
      </div>

      <div class="fiche-produit__histoire">
        {{ histoire | safe }}
      </div>

      {% if vendu %}
        <p class="message-vendu">Cette pièce a trouvé preneur ! Une autre vous plaît peut-être dans <a href="/boutique/">la boutique</a>.</p>
      {% else %}
        {% include "partials/formulaire-interet.njk" %}
      {% endif %}
    </div>
  </div>
</article>
